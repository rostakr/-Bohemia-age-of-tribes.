{
  "name": "bohemia-age-of-tribes",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test scripts/check-core.mjs scripts/check-assets.mjs scripts/check-landscape.mjs scripts/check-storehouse.mjs scripts/check-workshop.mjs scripts/check-tree.mjs scripts/check-inhabitant.mjs scripts/check-dwelling-lods.mjs scripts/check-glb-tools.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "smoke:webgl2": "node scripts/browser-smoke.mjs",
    "smoke:interactions": "node scripts/browser-interactions.mjs",
    "smoke:lifecycle": "node scripts/browser-lifecycle.mjs",
    "smoke:webgpu": "node scripts/browser-webgpu-smoke.mjs",
    "smoke:phase1": "node scripts/browser-phase1-smoke.mjs",
    "check:glb": "node scripts/check-glb.mjs",
    "prepare:glb-normals": "node scripts/add-glb-normals.mjs",
    "prepare:supplied-previews": "node scripts/add-glb-normals.mjs assets/source/phase1/user-supplied/boii_carpentry_shed_open.original.glb public/assets/buildings/boii_carpentry_shed_open_qa_preview.glb && node scripts/add-glb-normals.mjs assets/source/phase1/user-supplied/boii_adult_worker.original.glb public/assets/characters/boii_adult_worker_qa_preview.glb",
    "check:supplied-previews": "node scripts/check-glb.mjs public/assets/buildings/boii_carpentry_shed_open_qa_preview.glb --min-tris 89000 --max-tris 91000 --require-normals --require-uv0 && node scripts/check-glb.mjs public/assets/characters/boii_adult_worker_qa_preview.glb --min-tris 14000 --max-tris 14500 --require-normals --require-uv0",
    "check:phase1-assets": "node --check scripts/check-glb.mjs && node --check scripts/add-glb-normals.mjs && node --check scripts/check-phase1-assets.mjs && node scripts/check-phase1-assets.mjs",
    "validate": "npm run typecheck && npm test && npm run check:phase1-assets && npm run check:supplied-previews && npm run build",
    "prevalidate": "npm run prepare:supplied-previews",
    "generate:dwelling-lods": "node scripts/generate-dwelling-lods.mjs public/assets/buildings/boii_dwelling_rectangular.glb public/assets/buildings",
    "pretest": "npm run generate:dwelling-lods",
    "prebuild": "npm run generate:dwelling-lods",
    "predev": "npm run generate:dwelling-lods"
  },
  "dependencies": {
    "playcanvas": "2.22.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "8.3.0"
  }
}
